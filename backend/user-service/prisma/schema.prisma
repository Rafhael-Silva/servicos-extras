// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -- Enums --
enum CurriculumType {
  UPLOAD
  PLATFORM
}

// -- Person Profile Model --
model PersonProfile {
  authUserId String         @id
  phone      String         @unique @db.VarChar(20)
  photoKey   String?
  bio        String?        @db.VarChar(500)
  address    PersonAddress?
  curriculum Curriculum?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

// -- Person Address Model --
model PersonAddress {
  personId     String   @id
  street       String   @db.VarChar(255)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(100)
  neighborhood String   @db.VarChar(100)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(2)
  zipCode      String   @db.VarChar(15)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  person PersonProfile @relation(fields: [personId], references: [authUserId], onDelete: Cascade)
}

// -- Curriculum Model --
model Curriculum {
  personId            String         @id
  type                CurriculumType
  fileKey             String?
  professionalSummary String?
  experiences         Json?
  educations          Json?
  courses             Json?
  skills              Json?
  observations        String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  person PersonProfile @relation(fields: [personId], references: [authUserId], onDelete: Cascade)
}

// -- Company Profile Model --
model CompanyProfile {
  authUserId  String          @id
  companyName String          @db.VarChar(150)
  phone       String          @unique @db.VarChar(20)
  logoKey     String?
  bio         String?         @db.VarChar(500)
  address     CompanyAddress?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// -- Company Address Model --
model CompanyAddress {
  companyId    String   @id
  street       String   @db.VarChar(255)
  number       String   @db.VarChar(20)
  complement   String?  @db.VarChar(100)
  neighborhood String   @db.VarChar(100)
  city         String   @db.VarChar(100)
  state        String   @db.VarChar(2)
  zipCode      String   @db.VarChar(15)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company CompanyProfile @relation(fields: [companyId], references: [authUserId], onDelete: Cascade)
}
